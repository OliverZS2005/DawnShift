{
  "name": "dawnshift",
  "version": "0.1.0",
  "description": "A team of AI coworkers you run yourself. Each bot can use Claude, ChatGPT, Grok, Gemini, or a local model.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "notices": "node scripts/notices.mjs",
    "package": "node scripts/package.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:app": "node scripts/build-web.mjs --app && cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "openai": "^7.23.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "esbuild": "^0.28.2"
  }
}
