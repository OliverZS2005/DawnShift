; Cash Clash desktop app (Godot 4.3+). Open this folder in Godot, or see ../README.md to export.
config_version=5

[application]
config/name="Cash Clash"
config/description="Money tycoon + arena shooter. Shares saves with the web version."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]
CC="*res://rules.gd"
Game="*res://game.gd"

[display]
window/size/viewport_width=1150
window/size/viewport_height=760
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
