; Cash Clash desktop app (Godot 4.3+). Open this folder in Godot, or see ../README.md to export.
config_version=5

[application]
config/name="Cash Clash"
config/description="Money tycoon + arena shooter. Shares saves with the web version."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
CC="*res://rules.gd"
Game="*res://game.gd"
R3D="*res://r3d.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="expand"

[rendering]
; Forward+ gives ambient occlusion, glow and better shadows; PCs without Vulkan/D3D12 fall back to OpenGL.
renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
; needed to export for Apple Silicon Macs
textures/vram_compression/import_etc2_astc=true
