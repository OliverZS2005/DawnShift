; Hustlefront desktop app (Godot 4.3+). Open this folder in Godot, or see ../README.md to export.
config_version=5

[application]
config/name="Hustlefront"
config/description="Money tycoon + arena shooter. Shares saves with the web version."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
CC="*res://rules.gd"
Game="*res://game.gd"
R3D="*res://r3d.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/aspect="expand"
; phones and tablets: landscape either way up
window/handheld/orientation=4

[rendering]
; Vulkan everywhere (Forward+): global illumination, volumetric fog, reflections, ambient occlusion,
; glow and soft shadows. Macs run Vulkan through MoltenVK. Only a PC with no Vulkan support at all
; falls back to OpenGL (simpler lighting) instead of refusing to start.
renderer/rendering_method="forward_plus"
; phones and tablets use Godot's Mobile renderer (Vulkan, made for phone GPUs: glow, shadows and fog, but
; no screen-space AO, reflections or volumetric haze); phones without Vulkan fall back to OpenGL ES
renderer/rendering_method.mobile="mobile"
rendering_device/driver.android="vulkan"
rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.macos="vulkan"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
; needed to export for Apple Silicon Macs
textures/vram_compression/import_etc2_astc=true
