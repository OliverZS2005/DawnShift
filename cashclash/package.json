{
  "name": "dawnshift-server",
  "version": "1.0.0",
  "private": true,
  "description": "Host your own DawnShift multiplayer server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:three": "esbuild tools/three-bundle.js --bundle --minify --format=iife --legal-comments=eof --outfile=vendor/three.bundle.js",
    "fetch-assets": "node tools/fetch-assets.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.24.2",
    "meshoptimizer": "^0.21.0",
    "sharp": "^0.33.5",
    "three": "^0.169.0"
  }
}
